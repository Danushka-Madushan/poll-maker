rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /polls/{pollId} {
      allow read: if true;
      allow create: if request.resource.data.title is string;
      allow update: if true;
      allow delete: if true;

      // Options subcollection
      match /options/{optionId} {
        allow read, write, delete: if true;
      }

      // Participants subcollection (anonymous device token)
      match /participants/{deviceToken} {
        allow read, write, delete: if true;
      }

      // Votes subcollection (one vote per device token; only accepted while poll is live)
      match /votes/{deviceToken} {
        allow read: if true;
        allow create, update: if get(/databases/$(database)/documents/polls/$(pollId)).data.status == 'live';
        allow delete: if true;
      }
    }
  }
}
